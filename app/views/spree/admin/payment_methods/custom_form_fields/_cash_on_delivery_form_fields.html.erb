<h5><%= t('cash_on_delivery.fee_settings') %></h5>
<p class="card-text"><%= t('cash_on_delivery.fee_tiers_explanation') %></p>

<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
      <tr>
        <th><%= t('cash_on_delivery.tier_number') %></th>
        <th><%= t('cash_on_delivery.order_amount_up_to') %></th>
        <th><%= t('cash_on_delivery.fee_amount') %></th>
      </tr>
    </thead>
    <tbody>
      <% (1..Spree::PaymentMethod::CashOnDelivery::TOTAL_TIER).each do |i| %>
        <tr>
          <td><%= i %></td>
          <td>
            <div class="form-group">
              <%= f.text_field :"preferred_tier#{i}_threshold", class: 'form-control' %>
            </div>
          </td>
          <td>
            <div class="form-group">
              <%= f.text_field :"preferred_tier#{i}_fee", class: 'form-control' %>
            </div>
          </td>
        </tr>
      <% end %>

      <tr class="table-secondary">
        <td colspan="2">
          <strong><%= t('cash_on_delivery.max_fee_label') %></strong>
          <br>
          <small class="text-muted"><%= t('cash_on_delivery.max_fee_hint') %></small>
        </td>
        <td>
          <div class="form-group">
            <%= f.text_field :preferred_max_fee, class: 'form-control' %>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<div class="alert alert-info mt-3">
  <i class="icon icon-info-circle"></i>
  <%= t('cash_on_delivery.fee_tiers_info') %>
</div>

<div class="form-group">
  <%= f.label :preferred_tax_category_id, Spree.t(:tax_category) %>
  <%= f.collection_select(
    :preferred_tax_category_id,
    Spree::TaxCategory.all,
    :id,
    :name,
    { include_blank: Spree.t(:none) },
    { class: 'custom-select' }
  ) %>
  <span class="text-muted form-text mt-2">
    内税計算を適用する税カテゴリーを選択してください
  </span>
</div>
